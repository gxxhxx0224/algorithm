import java.util.Scanner;

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        
        // N을 입력받음
        int N = sc.nextInt();
        
        // 첫 번째 부분: 별이 증가하는 부분
        for (int i = 1; i <= N; i++) {
            for (int j = 1; j <= i; j++) {
                System.out.print("*");
            }
            System.out.println();  // 줄 바꿈
        }
        
        // 두 번째 부분: 별이 감소하는 부분
        for (int i = N - 1; i >= 1; i--) {
            for (int j = 1; j <= i; j++) {
                System.out.print("*");
            }
            System.out.println();  // 줄 바꿈
        }
    }
}
